APP_NAME=MoneyMind AI
APP_ENV=development
DATABASE_URL=sqlite:///./data/moneymind.db
AUTH_SECRET_KEY=replace_with_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
LLM_API_KEY=
GROQ_IP_FAMILY=auto
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.46
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_UPLOAD_MAX_BYTES=10485760
RAG_UPLOAD_DIRECTORY=./data/knowledge/uploads
RAG_DIRECTORY=./data/chroma
AGENT_CHECKPOINT_PATH=./data/agent-checkpoints.db
BACKEND_URL=http://127.0.0.1:8000
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=moneymind-local